# Django 基础配置
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=replace-me
ALLOWED_HOSTS=127.0.0.1,localhost

# 数据库模式
DJANGO_DB_ENGINE=django.db.backends.sqlite3

# PostgreSQL 示例配置
POSTGRES_DB=django_edu_manage
